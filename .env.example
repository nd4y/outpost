# Dedicated existing empty backup directory, writable by UID/GID 65532.
BACKUP_PATH=/volume1/outpost-backup
# Set your actual management HTTPS URL; no default cloud enrollment.
NB_MANAGEMENT_URL=https://netbird.example.com
NB_HOSTNAME=outpost-site-01
# Per-site one-off setup key with Auto-assign groups=outpost.
# Keep empty after enrollment; preserve the outpost-hardened-state volume.
NB_SETUP_KEY=
# Generate a random 32+ character password; not your backup encryption password.
OUTPOST_RSYNC_PASSWORD=
OUTPOST_IMAGE=ghcr.io/nd4y/outpost:edge

# Includes filesystem cache; tune to available RAM on the actual NAS.
OUTPOST_MEMORY_LIMIT=1g

# Both endpoints are required to enable push. Use write-only ingest endpoints.
OUTPOST_METRICS_URL=
OUTPOST_LOGS_URL=
# netbird uses the internal loopback SOCKS5 bridge; no direct fallback.
OUTPOST_TELEMETRY_TRANSPORT=netbird
# Per signal, persistent disk queue. Values: 512MiB, 1GiB, 2GiB, 4GiB.
OUTPOST_TELEMETRY_BUFFER=1GiB
OUTPOST_TELEMETRY_INTERVAL=30s
# Optional write-only bearer token. The installer also accepts its host _FILE.
OUTPOST_TELEMETRY_TOKEN=
